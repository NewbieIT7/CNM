<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Chi Tiết Sản Phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f5f7fa; padding-top: 50px; }
        .detail-card { background: #fff; border-radius: 15px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        .product-img { width: 100%; height: 400px; object-fit: contain; background: #fafafa; border-right: 1px solid #eee; }
        .info-section { padding: 40px; }
        .price-tag { font-size: 2rem; color: #0d6efd; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <div class="detail-card row g-0">
            <div class="col-md-6">
                <img src="<%= product.url_image %>" class="product-img" alt="<%= product.name %>" onerror="this.src='https://via.placeholder.com/400'">
            </div>
            <div class="col-md-6 info-section">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/products">Kho hàng</a></li>
                        <li class="breadcrumb-item active">Chi tiết</li>
                    </ol>
                </nav>
                
                <h1 class="display-5 fw-bold mb-3"><%= product.name %></h1>
                <p class="text-muted mb-4">Mã sản phẩm: <span class="fw-bold"><%= product.id %></span></p>
                
                <div class="price-tag mb-4">$<%= product.price %></div>
                
                <div class="mb-4">
                    <h5 class="fw-bold">Trạng thái kho:</h5>
                    <% if (product.unit_in_stock > 0) { %>
                        <span class="badge bg-success fs-6">Còn hàng (<%= product.unit_in_stock %> sản phẩm)</span>
                    <% } else { %>
                        <span class="badge bg-danger fs-6">Hết hàng</span>
                    <% } %>
                </div>

                <hr class="my-4">
                
                <div class="d-flex gap-3">
                    <a href="/products/edit/<%= product.id %>" class="btn btn-outline-secondary btn-lg px-4">Chỉnh sửa</a>
                    <a href="/products" class="btn btn-dark btn-lg px-4">Quay lại danh sách</a>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>