<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Sửa Sản Phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; height: 100vh; display: flex; align-items: center; }
        .edit-box { background: #fff; border-radius: 20px; padding: 40px; box-shadow: 0 20px 50px rgba(0,0,0,0.1); width: 100%; max-width: 450px; margin: auto; }
        .preview-img { border-radius: 10px; margin-bottom: 20px; border: 2px solid #f8f9fa; }
    </style>
</head>
<body>
    <div class="edit-box">
        <h4 class="text-center fw-bold mb-4">CẬP NHẬT THÔNG TIN</h4>
        <div class="text-center">
            <img src="<%= product.img %>" width="100" height="100" class="preview-img">
        </div>
        <form action="/products/edit/<%= product.id %>" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label small fw-bold">TÊN SẢN PHẨM</label>
                <input name="name" class="form-control" value="<%= product.name %>" required>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-bold">GIÁ BÁN ($)</label>
                <input name="price" type="number" step="0.01" class="form-control" value="<%= product.price %>" required>
            </div>
            <div class="mb-4">
                <label class="form-label small fw-bold">THAY ĐỔI ẢNH</label>
                <input type="file" name="img" class="form-control" accept="image/*">
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-dark py-2 fw-bold">CẬP NHẬT NGAY</button>
                <a href="/products" class="text-center text-muted text-decoration-none small">Quay về</a>
            </div>
        </form>
    </div>
</body>
</html>