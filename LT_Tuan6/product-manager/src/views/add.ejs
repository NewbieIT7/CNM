<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Thêm Sản Phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; height: 100vh; display: flex; align-items: center; }
        
        .add-card { 
            background: #ffffff; 
            border-radius: 20px; 
            padding: 40px; 
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 450px;
            margin: auto;
        }

        .form-label { font-weight: 700; color: #4b4b4b; font-size: 0.85rem; margin-bottom: 8px; }
        .form-control { 
            border: 2px solid #f1f3f5; 
            border-radius: 10px; 
            padding: 12px;
            transition: 0.3s;
        }
        .form-control:focus { border-color: #000; box-shadow: none; background-color: #fafafa; }

        .btn-submit { background: #000; color: #fff; border: none; padding: 14px; border-radius: 10px; font-weight: 700; margin-top: 20px; }
        .btn-submit:hover { background: #333; }
        .back-link { display: block; text-align: center; margin-top: 20px; color: #b5b5b5; text-decoration: none; font-size: 0.9rem; }
        .back-link:hover { color: #000; }
    </style>
</head>
<body>
    <div class="add-card">
        <h4 class="text-center fw-bold mb-4">THÔNG TIN MỚI</h4>
        <form action="/products/add" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">TÊN SẢN PHẨM</label>
                <input name="name" class="form-control" placeholder="Ví dụ: iPhone 15 Pro" required>
            </div>
            <div class="mb-3">
                <label class="form-label">GIÁ NIÊM YẾT ($)</label>
                <input name="price" type="number" step="0.01" class="form-control" placeholder="0.00" required>
            </div>
            <div class="mb-4">
                <label class="form-label">CHỌN HÌNH ẢNH</label>
                <input type="file" name="img" class="form-control" accept="image/*" required>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-submit">LƯU VÀO HỆ THỐNG</button>
                <a href="/products" class="back-link">Hủy bỏ và quay lại</a>
            </div>
        </form>
    </div>
</body>
</html>