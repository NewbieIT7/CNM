<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Sửa Sản Phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center" style="height: 100vh;">
    <div class="card mx-auto shadow" style="width: 400px; border-radius: 15px;">
        <div class="card-body p-4 text-center">
            <h4 class="fw-bold mb-3">CẬP NHẬT</h4>
            <img src="<%= product.url_image %>" width="80" height="80" class="rounded mb-3 border" onerror="this.src='https://via.placeholder.com/80'">
            <% if (locals.message) { %>
                <div class="alert alert-danger py-2 small"><%= message %></div>
            <% } %>
            <form action="/products/edit/<%= product.id %>" method="POST" enctype="multipart/form-data" class="text-start">
                <div class="mb-3">
                    <label class="form-label small fw-bold">TÊN SẢN PHẨM</label>
                    <input name="name" class="form-control" value="<%= product.name %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">GIÁ BÁN ($)</label>
                    <input name="price" type="number" step="0.01" min="0.01" class="form-control" value="<%= product.price %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">SỐ LƯỢNG TỒN KHO</label>
                    <input name="unit_in_stock" type="number" min="0" class="form-control" value="<%= product.unit_in_stock %>" required>
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-bold">THAY ĐỔI ẢNH (KHÔNG BẮT BUỘC)</label>
                    <input type="file" name="img" class="form-control" accept="image/*">
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-bold py-2">CẬP NHẬT NGAY</button>
                <a href="/products" class="d-block text-center mt-3 text-muted small text-decoration-none">Quay về</a>
            </form>
        </div>
    </div>
</body>
</html>