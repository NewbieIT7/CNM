<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Thêm sản phẩm mới</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8f9fc; }
        .form-card { 
            background: white; border-radius: 20px; border: none; padding: 40px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05); animation: slideUp 0.5s ease-out;
        }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .form-label { font-weight: 600; font-size: 0.9rem; color: #475569; }
        .form-control { border: 1.5px solid #e2e8f0; padding: 12px; border-radius: 10px; }
        .form-control:focus { border-color: #4f46e5; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1); }
        .btn-save { background: #4f46e5; border: none; padding: 12px; border-radius: 10px; font-weight: 600; transition: 0.3s; }
        .btn-save:hover { background: #4338ca; transform: translateY(-2px); }
    </style>
</head>
<body>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="form-card">
                <h4 class="fw-bold text-center mb-4">Thông tin sản phẩm</h4>
                <form action="/add" method="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Tên sản phẩm</label>
                        <input type="text" name="name" class="form-control" placeholder="Ví dụ: iPhone 15 Pro" required>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Giá (VNĐ)</label>
                            <input type="number" name="price" class="form-control" placeholder="0" required>
                        </div>
                        <div class="col">
                            <label class="form-label">Số lượng</label>
                            <input type="number" name="quantity" class="form-control" placeholder="0" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Hình ảnh S3</label>
                        <input type="file" name="image" class="form-control" accept="image/*" required>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-save text-white">Lưu sản phẩm</button>
                        <a href="/" class="btn btn-link text-muted text-decoration-none text-center">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</body>
</html>