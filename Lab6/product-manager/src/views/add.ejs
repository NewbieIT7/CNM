<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Thêm Sản Phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center" style="height: 100vh;">
    <div class="card mx-auto shadow" style="width: 400px; border-radius: 15px;">
        <div class="card-body p-4">
            <h4 class="text-center fw-bold mb-4">THÊM MỚI</h4>
            <% if (locals.message) { %>
                <div class="alert alert-danger py-2 small"><%= message %></div>
            <% } %>
            <form action="/products/add" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label small fw-bold">TÊN SẢN PHẨM</label>
                    <input name="name" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">GIÁ BÁN ($)</label>
                    <input name="price" type="number" step="0.01" min="0.01" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">SỐ LƯỢNG TỒN KHO</label>
                    <input name="unit_in_stock" type="number" min="0" class="form-control" required>
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-bold">HÌNH ẢNH</label>
                    <input type="file" name="img" class="form-control" accept="image/*" required>
                </div>
                <button type="submit" class="btn btn-dark w-100 fw-bold py-2">LƯU SẢN PHẨM</button>
                <a href="/products" class="d-block text-center mt-3 text-muted small text-decoration-none">Hủy bỏ</a>
            </form>
        </div>
    </div>
</body>
</html>